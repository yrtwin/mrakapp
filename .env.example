# MRAK8 · Central Booking — переменные окружения. Скопируйте в .env и заполните.
# Обязательные в проде: BOT_TOKEN, WEBAPP_URL, PUBLIC_URL, DATABASE_URL, PAYMENT_PROVIDER_TOKEN, ADMIN_IDS.

# NODE_ENV в .env не пишите: Vite читает этот файл и собрал бы отладочную версию фронта.
# production задаёт docker-compose (или переменная окружения на хостинге), без него сервер в режиме разработки.
HOST=0.0.0.0
PORT=8080

# ---------------------------------------------------------------- адреса
# публичный https-адрес бэкенда: сюда придёт вебхук бота, отсюда раздаются фото (если STORAGE_DRIVER=local)
PUBLIC_URL=https://api.mrak8.ru
# где лежит мини-апп (web/dist). Если бэкенд сам раздаёт фронт (SERVE_WEB=1) — тот же адрес, что PUBLIC_URL
WEBAPP_URL=https://app.mrak8.ru
# прямая ссылка на мини-апп для канала и deep links: https://t.me/<бот>/<короткое имя из /newapp>
# или https://t.me/<бот>, если в @BotFather назначен Main Mini App
MINIAPP_LINK=https://t.me/mrak8_bot/shop
# раздавать web/dist тем же процессом (один домен, один деплой)
SERVE_WEB=0
# дополнительные origin для CORS через запятую (WEBAPP_URL добавляется сам)
CORS_ORIGINS=

# ---------------------------------------------------------------- бот
# токен из @BotFather
BOT_TOKEN=
# webhook | polling | off | auto (auto: webhook в проде с https PUBLIC_URL, иначе polling)
BOT_MODE=auto
# обязателен для вебхука: 32+ случайных символов [A-Za-z0-9_-], сгенерируйте: openssl rand -hex 32
# Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token; без него сервер в проде не стартует
WEBHOOK_SECRET=
# Telegram user id дежурных через запятую (узнать свой id: @userinfobot). Только они видят Control room.
ADMIN_IDS=
# чат для уведомлений о новых заказах (группа или личка; у группы id начинается с -100)
ADMIN_CHAT_ID=
# канал для анонсов: @mrak8 или -100…; бот должен быть админом канала
CHANNEL_ID=@mrak8
# только если Telegram с этой машины доступен лишь через VPN/прокси (локальная разработка): http://127.0.0.1:10809
TELEGRAM_PROXY=
# prod | test — test: тестовая среда Telegram (свои аккаунты и боты), там мини-апп можно открывать по http://127.0.0.1
TELEGRAM_ENV=prod

# ---------------------------------------------------------------- локально в Docker (npm run docker:local)
# как контейнер ходит в api.telegram.org; по умолчанию прокси Docker Desktop (он идёт через прокси Windows / Happ)
# DOCKER_TELEGRAM_PROXY=http://host.docker.internal:10809
# docker:public: через какой прокси туннель подключается к localhost.run (по умолчанию Happ — чтобы не светить домашний IP); пусто — напрямую
# DOCKER_TUNNEL_PROXY=host.docker.internal:10809

# ---------------------------------------------------------------- оплата (Telegram Payments)
# yookassa | tbank | cloudpayments | none — физические товары, Stars не подходят
PAYMENT_PROVIDER=yookassa
# токен провайдера из @BotFather → Payments. Тестовый выглядит как 381764678:TEST:12345
PAYMENT_PROVIDER_TOKEN=
# 54-ФЗ: vat_code по справочнику ЮKassa (1 — без НДС). Уточните у бухгалтера под вашу систему налогообложения.
RECEIPT_VAT_CODE=1
# необязательно: tax_system_code ЮKassa (1 — ОСН, 2 — УСН доходы, 3 — УСН доходы-расходы …)
RECEIPT_TAX_SYSTEM_CODE=
# phone — чек на телефон (Telegram спросит номер в форме оплаты), email — на e-mail
RECEIPT_CONTACT=phone
# сколько минут держим вещи в резерве до оплаты
RESERVE_MINUTES=15

# ---------------------------------------------------------------- СДЭК
# off — фиксированные цены доставки из Control room; test — тестовый сервер СДЭК (посылки не создаются по-настоящему);
# live — боевой: ключи из lk.cdek.ru → Интеграция (договор со СДЭК)
CDEK_MODE=off
CDEK_ACCOUNT=
CDEK_SECURE=
# код пункта СДЭК, куда вы сдаёте посылки (обязателен для live; в test — MSK2), город отправки (44 — Москва)
CDEK_SHIPMENT_POINT=
CDEK_FROM_CITY=44
# одна упакованная вещь: граммы:длина x ширина x высота (см)
CDEK_PARCEL=1000:35x25x10

# ---------------------------------------------------------------- база
# docker-compose.yml (обязательны): пароль роли приложения mrak8 и суперпользователя postgres — разные случайные строки.
# Роль mrak8 создаёт docker/db-init.sh при первом запуске пустой базы, суперпользователем она не является
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
# PostgreSQL 14+. Пусто — встроенная PGlite в PGLITE_DIR (только для разработки и демо)
DATABASE_URL=postgres://mrak8:mrak8@localhost:5432/mrak8
PGLITE_DIR=./data/pglite

# ---------------------------------------------------------------- фото
# local — файлы в MEDIA_DIR, раздаются по PUBLIC_URL/media; s3 — любое S3-совместимое хранилище
STORAGE_DRIVER=s3
MEDIA_DIR=./data/media
# для local можно переопределить (например /media при одном домене)
MEDIA_PUBLIC_URL=
# Yandex Object Storage: endpoint https://storage.yandexcloud.net, region ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=mrak8-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# публичный адрес бакета (или CDN перед ним)
S3_PUBLIC_URL=https://storage.yandexcloud.net/mrak8-media
S3_FORCE_PATH_STYLE=0

# ---------------------------------------------------------------- разработка
# только вне production: принимать X-Dev-User вместо подписи Telegram (браузер без Telegram)
DEV_AUTH=0
# срок жизни initData, секунды
INIT_DATA_MAX_AGE=86400
# при первом старте создать товар #001 из фото в корне репозитория (1) и демо-позиции #002/#003 (SEED_DEMO=1)
SEED_ON_START=1
SEED_DEMO=0

# ---------------------------------------------------------------- фронт (сборка web)
# пусто — API на том же домене. Иначе https://api.mrak8.ru
VITE_API_URL=
# куда отправлять тех, кто открыл мини-апп в обычном браузере
VITE_MINIAPP_LINK=https://t.me/mrak8_bot/shop
